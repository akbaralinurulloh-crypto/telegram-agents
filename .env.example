# =================================================================
# TELEGRAM SOZLAMALARI
# =================================================================
# Telegram API ma'lumotlarini https://my.telegram.org saytidan olasiz:
# 1. Saytga kiring va telefon raqamingiz orqali tasdiqlang.
# 2. 'API development tools' bo'limiga o'ting.
# 3. Ixtiyoriy nom kiriting (masalan: my_agent) va API ID hamda API Hash oling.
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=abcdef1234567890abcdef1234567890

# Sessiya fayli nomi (o'zgartirmasa ham bo'ladi)
TELEGRAM_SESSION_NAME=telegram_ai_agent

# =================================================================
# GOOGLE GEMINI AI SOZLAMALARI
# =================================================================
# Bepul API kalitni https://aistudio.google.com saytidan olasiz:
# 1. 'Get API key' tugmasini bosing va kalit yarating.
GEMINI_API_KEY=AIzaSy...
GEMINI_MODEL=gemini-2.0-flash

# =================================================================
# KANALLAR SOZLAMALARI
# =================================================================
# Kuzatiladigan 2 ta manba kanal (username yoki kanal ID lari, vergul bilan ajrating)
SOURCE_CHANNELS=@manba_kanal1, @manba_kanal2

# AI tahlilidan o'tgan sara postlar joylanadigan sizning asosiy kanalingiz
TARGET_CHANNEL=@mening_kanalim

# =================================================================
# SARALASH VA MAVZU SOZLAMALARI
# =================================================================
# Minimal qabul qilish bali (1 dan 10 gacha). Masalan 7 qo'yilsa, faqat 7, 8, 9, 10 balli sifatli postlar joylanadi.
MIN_QUALITY_SCORE=7

# Kanal mavzusi (AI shunga mos ravishda qiziqarli izoh yozadi)
CHANNEL_TOPIC=Qiziqarli faktlar, jahon yangiliklari, ilmiy kashfiyotlar va foydali kontent

# =================================================================
# GOOGLE SHEETS JONLI ANALITIKA (Ixtiyoriy)
# =================================================================
# google_apps_script.js faylidagi Apps Script Webhook URL manzili:
GOOGLE_SHEETS_WEBHOOK_URL=
