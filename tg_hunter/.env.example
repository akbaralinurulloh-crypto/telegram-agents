# --- Telegram (my.telegram.org -> API development tools) ---
TG_API_ID=
TG_API_HASH=
TG_SESSION_PATH=data/hunter.session
# Ixtiyoriy (Railway/Render kabi GitHub'dan o'rnatiladigan xizmatlar uchun): sessiya matn ko'rinishida.
# Sessiya fayli yo'q bo'lsa, shundan yaratiladi. Olish: python -m scripts.export_session
# DIQQAT: bu matn Telegram akkauntingizga TO'LIQ kirish beradi. GitHub'ga, chatga, skrinshotga qo'ymang!
TG_SESSION_STRING=

# --- Bot (@BotFather); bot mening kanalimda admin bo'lishi shart ---
BOT_TOKEN=
ADMIN_ID=
TARGET_CHANNEL=@muhtashamtraveluzz

# --- Manba kanallar (vergul bilan): @kanal1,@kanal2,-1001234567890 ---
SOURCE_CHANNELS=@nurlisafar,@muhtashamtravel,@MuhtashamUmra

# --- LLM (config.yaml dagi llm.provider ga qarab bittasi kifoya) ---
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# --- Tizim ---
DATABASE_URL=sqlite+aiosqlite:///data/hunter.db
DRY_RUN=true               # tasdiqlamaguncha true qoldiring
CONFIG_PATH=config.yaml
LOG_LEVEL=INFO
